# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it's already in .gitignore).

# ============================================================
# REQUIRED
# ============================================================

# Groq API key - powers every LLM call in this project (model set in config.py)
# Get one at https://console.groq.com
GROQ_API_KEY=

# PostgreSQL connection string - used by LangGraph's checkpointer to persist
# conversation state across requests (required, the app will not start without it)
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql:

# Tavily search API key - used by the hotel agent for live web search
# Get one at https://tavily.com
TAVILY_API_KEY=

# AviationStack API key - used by the flight agent for airport/airline data
# Get one at https://aviationstack.com
AVIATION_STACK_API_KEY=

# OpenWeather API key - used by the local weather MCP server
# Get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ============================================================
# OPTIONAL - fallback keys
# ============================================================
# Leave any of these blank and that service just uses its one key above,
# with no retry - exactly like before. Fill one in and the app will
# automatically retry once with it if the primary key above fails for
# that service (e.g. a rate limit, or an invalid/expired key).
#
# Handy if you're on free tiers as a student: keep a second free account
# for a service and put its key here as a backup.

GROQ_API_KEY_FALLBACK=
TAVILY_API_KEY_FALLBACK=
AVIATION_STACK_API_KEY_FALLBACK=
OPENWEATHER_API_KEY_FALLBACK=
